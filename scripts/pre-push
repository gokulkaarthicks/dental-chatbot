#!/usr/bin/env bash
# git pre-push hook: every push must pass lint (auto-fixed) + tests.
#
# Installed into .git/hooks/pre-push by scripts/install-git-hooks.sh.
# The actual work lives in scripts/check-before-push.sh so `make check` and the
# hook can never drift apart.

set -uo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

printf '\033[1;33m▶ pre-push: lint + tests (auto-fix enabled)\033[0m\n'

# Capture this push's target refs *before* anything rewrites the working tree.
# The first push of a branch has no upstream, so fall back to origin/<branch>.
BRANCH="$(git rev-parse --abbrev-ref HEAD)"
if ! PUSH_REFS="$(git rev-parse --abbrev-ref --symbolic-full-name '@{push}' 2>/dev/null)"; then
  PUSH_REFS="origin/$BRANCH"
fi

if ! bash "$REPO_ROOT/scripts/check-before-push.sh"; then
  printf '\n\033[1;31m✖ Push aborted — fix the problems above and push again.\033[0m\n'
  printf '  (Emergency bypass, not recommended: git push --no-verify)\n'
  exit 1
fi

# ruff --fix may have rewritten files. If a *committed* backend file changed,
# fold the fix into the commit being pushed so the remote never receives code
# the tests did not see, and so the next push does not fail on stale lint.
# Widen the pathspec to the whole repo: on a fresh repo the backend may not be
# committed yet, and the unchanged files it yields are harmless.
COMMITTED_DIRTY="$(git diff --name-only HEAD -- '*.py')"
if [ -n "$COMMITTED_DIRTY" ]; then
  printf '\n\033[1;33m⚙ Lint auto-fix rewriting already-committed files:\033[0m\n'
  printf '%s\n' "$COMMITTED_DIRTY" | sed 's/^/    /'

  git add -u -- '*.py'
  if ! git commit --amend --no-edit --quiet; then
    printf '\033[1;31m✖ Could not amend automatically. Run:\033[0m\n'
    printf '    git add -u backend && git commit --amend --no-edit\n'
    printf '  then push again.\n'
    exit 1
  fi
  printf '  Amended the lint fixes into HEAD.\n'

  printf '  Upstream %s now needs a force-with-lease to accept the amended commit.\n' "$PUSH_REFS"
  if git push --force-with-lease --quiet; then
    printf '\033[1;32m✔ Amended commit force-with-lease pushed; done.\033[0m\n'
    exit 0
  fi

  printf '\n\033[1;31m✖ The amend changed the commit, so the original push was cancelled.\033[0m\n'
  printf '  Just run "git push" again — it will now pass on the fixed commit.\n'
  exit 1
fi

printf '\033[1;32m✔ pre-push checks passed\033[0m\n'
